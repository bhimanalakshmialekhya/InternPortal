# InternPortal Server Environment Variables
PORT=5000
MONGO_URI=mongodb://localhost:27017/
SECRET_KEY=internportal_secret_key_2025
GROQ_API_KEY=your_groq_api_key_here

# App URLs
FRONTEND_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# ── 1. GOOGLE OAUTH 2.0 ──────────────────────────────────────────
# Register at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5000/auth/oauth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/oauth/callback/google

# ── 2. GITHUB OAUTH ──────────────────────────────────────────────
# Register at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:5000/auth/oauth/callback/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/auth/oauth/callback/github

# ── 3. LINKEDIN OAUTH 2.0 (OpenID Connect) ──────────────────────
# Register at: https://www.linkedin.com/developers/apps
# Authorized redirect URL for your app: http://localhost:5000/auth/oauth/callback/linkedin
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_CALLBACK_URL=http://localhost:5000/auth/oauth/callback/linkedin
